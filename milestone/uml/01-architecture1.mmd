graph TB
    subgraph CLIENT["Client (React + Vite)"]
        UI["UI Components"]
        STORE["Zustand State Store"]
        UI <--> STORE
    end

    subgraph SERVER["Server (Node.js + Express)"]
        API["tRPC API Router"]
        ENGINE["Matching Engine"]
        OB["Order Book"]
        PM["Portfolio Manager"]
        API --> ENGINE
        ENGINE --> OB
        ENGINE --> PM
    end

    subgraph SHARED["Shared Types (TypeScript)"]
        TYPES["Order · Trade · Portfolio"]
    end

    FIREBASE["Firebase Authentication"]

    CLIENT -- "HTTP (tRPC mutations)" --> SERVER
    SERVER -- "WebSocket (Socket.io)<br/>live order book updates" --> CLIENT
    CLIENT -- "sign in / ID token" --> FIREBASE
    SERVER -- "verify ID token" --> FIREBASE
    CLIENT -. "shared interfaces" .-> SHARED
    SERVER -. "shared interfaces" .-> SHARED

