---
title: Use-Case Diagram — Stock Order Book
---
graph LR
    subgraph ACTORS["Actors"]
        USER(["Authenticated User"])
        MM(["Market Maker<br/>(CLI Bot)"])
        ADMIN(["Admin"])
    end

    subgraph SYSTEM["Stock Order Book System"]
        direction TB

        subgraph AUTH_UC["Authentication"]
            UC_LOGIN["Sign In with Firebase"]
            UC_LOGOUT["Sign Out"]
        end

        subgraph TRADING_UC["Trading"]
            UC_PLACE["Place Limit Order<br/>(buy / sell)"]
            UC_CANCEL["Cancel Open Order"]
            UC_VIEW_BOOK["View Live Order Book<br/>(top 10 bids & asks)"]
            UC_VIEW_HISTORY["View Trade History"]
        end

        subgraph PORTFOLIO_UC["Portfolio"]
            UC_VIEW_PORTFOLIO["View Portfolio Balance<br/>(USD + Stocks)"]
            UC_BALANCE_CHECK["<<include>><br/>Balance Validation<br/>(canAfford check)"]
        end

        subgraph MARKET_UC["Market Operations"]
            UC_INJECT_BUY["Inject Buy Orders"]
            UC_INJECT_SELL["Inject Sell Orders"]
            UC_SEED["Seed Order Book<br/>(bulk inject)"]
        end

        subgraph ADMIN_UC["Admin / Dev Operations"]
            UC_HEALTH["Check Server Health<br/>GET /health"]
            UC_BENCHMARK["Run Performance<br/>Benchmark"]
            UC_RESET["Reset Server State"]
        end

        UC_PLACE -- "<<include>>" --> UC_BALANCE_CHECK
    end

    USER --> UC_LOGIN
    USER --> UC_LOGOUT
    USER --> UC_PLACE
    USER --> UC_CANCEL
    USER --> UC_VIEW_BOOK
    USER --> UC_VIEW_HISTORY
    USER --> UC_VIEW_PORTFOLIO

    MM --> UC_INJECT_BUY
    MM --> UC_INJECT_SELL
    MM --> UC_SEED

    ADMIN --> UC_HEALTH
    ADMIN --> UC_BENCHMARK
    ADMIN --> UC_RESET

    style SYSTEM fill:#111827,color:#f9fafb,stroke:#6b7280
    style AUTH_UC fill:#1e3a5f,color:#dbeafe,stroke:#3b82f6
    style TRADING_UC fill:#1a3a2a,color:#dcfce7,stroke:#22c55e
    style PORTFOLIO_UC fill:#2d1f5f,color:#ede9fe,stroke:#8b5cf6
    style MARKET_UC fill:#3a2a1a,color:#fef3c7,stroke:#f59e0b
    style ADMIN_UC fill:#3a1a1a,color:#fee2e2,stroke:#ef4444
    style ACTORS fill:#1f2937,color:#f9fafb,stroke:#374151
