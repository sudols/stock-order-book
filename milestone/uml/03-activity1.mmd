---
title: Activity Diagram — Place Order Flow
---
flowchart TD
    START([User submits order]) --> VALIDATE

    VALIDATE{"Valid inputs?"}
    VALIDATE -- No --> ERR1([Show error to user])
    VALIDATE -- Yes --> AUTH

    AUTH{"Firebase token<br/>verified?"}
    AUTH -- No --> ERR2([Unauthorized])
    AUTH -- Yes --> AFFORD

    AFFORD{"Can user<br/>afford order?"}
    AFFORD -- No --> ERR3([Insufficient funds])
    AFFORD -- Yes --> MATCH

    MATCH{"Matching order<br/>exists in book?"}
    MATCH -- No --> REST["Add order to book<br/>(resting order)"]
    MATCH -- Yes --> TRADE["Execute trade<br/>Update both portfolios"]

    TRADE --> MATCH

    REST --> BROADCAST
    TRADE --> BROADCAST

    BROADCAST["Broadcast updated<br/>order book to all clients"]
    BROADCAST --> END([Order placed])

    style START fill:#166534,color:#fff,stroke:#166534
    style END fill:#166534,color:#fff,stroke:#166534
    style ERR1 fill:#991b1b,color:#fff,stroke:#991b1b
    style ERR2 fill:#991b1b,color:#fff,stroke:#991b1b
    style ERR3 fill:#991b1b,color:#fff,stroke:#991b1b
