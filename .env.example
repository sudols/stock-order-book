# ── Server Configuration ───────────────────────────────────────
# (Optional) Real Firebase Admin SDK credentials
# If missing, server runs in MOCK AUTH mode (accepts any token starting with "mock-")
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── Client Configuration ───────────────────────────────────────
# (Optional) Real Firebase Client credentials
# If missing, client runs in MOCK AUTH mode (authenticates locally via Mock Login button)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
