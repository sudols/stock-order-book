# ── Server Configuration ───────────────────────────────────────
# (Optional) Real Firebase Admin SDK credentials
# If missing, server requires Firebase credentials to be configured
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Cloudflare Turnstile Backend Secret
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Market Maker Bot Secret (Optional, for internal bots to bypass limits)
BOT_SECRET_KEY=my-super-secret-bot-key

# ── Client Configuration ───────────────────────────────────────
# (Optional) Real Firebase Client credentials
# If missing, client runs in MOCK AUTH mode (authenticates locally via Mock Login button)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Cloudflare Turnstile Site Key (Frontend)
# '1x00000000000000000000AA' is Cloudflare's dummy test key that always passes
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
